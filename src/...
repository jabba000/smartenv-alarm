#include "screens.h"
#include "config.h"
#include "lcd_wrapper.h"
#include "rtc_wrapper.h"
#include "sensors.h"
#include <Arduino.h>
#include <EEPROM.h>
#include <stdio.h> 

// Button debounce function
bool is_button_pressed(int pin) {
    static unsigned long last_press = 0;
    if (digitalRead(pin) == LOW) {
        if (millis() - last_press > 250) { 
            last_press = millis();
            return true;
        }
    }
    return false;
}

// 1. Factory reset screen
enum screen factory_reset_screen(struct context *ctx) {
    lcd_clear();
    lcd_print_at(0, 0, (char*)"Factory Reset");
    
    ctx->alarmHour = 7;
    ctx->alarmMinute = 30;
    ctx->isAlarmActive = false;

    EEPROM.write(EEPROM_ALARM_HOUR_ADDR, ctx->alarmHour);
    EEPROM.write(EEPROM_ALARM_MIN_ADDR, ctx->alarmMinute);
    EEPROM.write(EEPROM_ALARM_ON_ADDR, ctx->isAlarmActive ? 1 : 0);

    delay(1500);
    lcd_clear();
    return CLOCK_SCR;
}

// 2. Main screen with time and alarm status
enum screen clock_screen(struct context *ctx) {
    static unsigned long last_update = 0;
    char buffer[17];

    if (millis() - last_update > 1000) {
        struct dt current_time = now();
        ctx->hour = current_time.hours;
        ctx->minute = current_time.minutes;
        ctx->second = current_time.seconds;

        if (ctx->isAlarmActive && ctx->hour == ctx->alarmHour && ctx->minute == ctx->alarmMinute && ctx->second == 0) {
            lcd_clear();
            return RINGING_SCR;
        }

        sprintf(buffer, "Time: %02d:%02d:%02d", ctx->hour, ctx->minute, ctx->second);
        lcd_print_at(0, 0, buffer);
        
        sprintf(buffer, "Alarm: %s", ctx->isAlarmActive ? "ON " : "OFF");
        lcd_print_at(1, 0, buffer);

        digitalWrite(RGB_RED_PIN, ctx->isAlarmActive ? HIGH : LOW);

        last_update = millis();
    }

    if (is_button_pressed(BTN1_PIN)) {
        lcd_clear();
        return ALARM_SCR; 
    }
    if (is_button_pressed(BTN2_PIN)) {
        lcd_clear();
        return SHOW_DATE_SCR; 
    }
    if (is_button_pressed(BTN3_PIN)) {
        lcd_clear();
        return SHOW_ENV_SCR; 
    }
    if (is_button_pressed(BTN4_PIN)) {
        ctx->isAlarmActive = !ctx->isAlarmActive;
        EEPROM.write(EEPROM_ALARM_ON_ADDR, ctx->isAlarmActive ? 1 : 0);
        last_update = 0; 
    }

    return CLOCK_SCR; 
}

// 3. Date screen
enum screen show_date_screen(struct context *ctx) {
    static unsigned long entry_time = 0; // 0 not init yet
    char buffer[17];
    
    // Init
    if (entry_time == 0) {
        entry_time = millis();
        if (entry_time == 0) entry_time = 1; // Avoid zero value 
        
        struct dt current_time = now();
        sprintf(buffer, "Date: %02d/%02d/%04d", current_time.day, current_time.month, current_time.year);
        lcd_print_at(0, 0, buffer);
        lcd_print_at(1, 0, (char*)"Push OK: EDIT ");
    }

    // Exit after 4 seconds of AFK
    if (millis() - entry_time > 4000) {
        entry_time = 0; // Reset flag
        lcd_clear();
        return CLOCK_SCR;
    }

    // Exit on button press
    if (is_button_pressed(BTN4_PIN)) {
        entry_time = 0; 
        lcd_clear();
        return SET_TIME_SCR;
    }

    return SHOW_DATE_SCR;
}

// 5. DHT11 | Temperature and humidity screen
enum screen show_env_screen(struct context *ctx) {
    static unsigned long entry_time = 0;
    static unsigned long last_read = 0;
    char buffer[17];

    // Inir
    if (entry_time == 0) {
        entry_time = millis();
        if (entry_time == 0) entry_time = 1;
        last_read = 0; // Force read on first entry
        lcd_clear();
        lcd_print_at(0, 0, (char*)"Reading DHT11...");
    }

    // Get data every 2 seconds
    if (millis() - last_read > 2000) {
        float temp = get_temperature();
        int hum = get_humidity();

        sprintf(buffer, "Temp: %.1f C     ", temp);
        lcd_print_at(0, 0, buffer);
        sprintf(buffer, "Hum:  %d %%       ", hum);
        lcd_print_at(1, 0, buffer);

        last_read = millis();
    }

    // Exit after 6 seconds of AFK
    if (millis() - entry_time > 6000 || is_button_pressed(BTN4_PIN)) {
        entry_time = 0;
        lcd_clear();
        return CLOCK_SCR;
    }

    return SHOW_ENV_SCR;
}

// 5. Alarm setting screen
enum screen alarm_screen(struct context *ctx) {
    static int edit_mode = 0; 
    static unsigned long last_update = 0;
    char buffer[17];

    if (millis() - last_update > 200) {
        lcd_print_at(0, 0, (char*)"Set Alarm Time: ");
        
        if (edit_mode == 0) sprintf(buffer, ">%02d< :  %02d   ", ctx->alarmHour, ctx->alarmMinute);
        else                sprintf(buffer, " %02d  : >%02d<  ", ctx->alarmHour, ctx->alarmMinute);
        
        lcd_print_at(1, 0, buffer);
        last_update = millis();
    }

    if (is_button_pressed(BTN1_PIN)) {
        edit_mode = (edit_mode + 1) % 2; 
        last_update = 0;
    }
    if (is_button_pressed(BTN2_PIN)) {
        if (edit_mode == 0) ctx->alarmHour = (ctx->alarmHour + 1) % 24;
        else ctx->alarmMinute = (ctx->alarmMinute + 1) % 60;
        last_update = 0;
    }
    if (is_button_pressed(BTN3_PIN)) {
        if (edit_mode == 0) ctx->alarmHour = (ctx->alarmHour == 0) ? 23 : ctx->alarmHour - 1;
        else ctx->alarmMinute = (ctx->alarmMinute == 0) ? 59 : ctx->alarmMinute - 1;
        last_update = 0;
    }
    if (is_button_pressed(BTN4_PIN)) {
        EEPROM.write(EEPROM_ALARM_HOUR_ADDR, ctx->alarmHour);
        EEPROM.write(EEPROM_ALARM_MIN_ADDR, ctx->alarmMinute);
        lcd_clear();
        edit_mode = 0;  
        return CLOCK_SCR;
    }

    return ALARM_SCR;
}

// 6. Ringing screen
enum screen ringing_screen(struct context *ctx) {
    static unsigned long last_toggle = 0;
    static bool toggle = false;

    if (millis() - last_toggle > 500) {
        toggle = !toggle;
        digitalWrite(BUZZER_PIN, toggle ? HIGH : LOW);
        digitalWrite(RGB_RED_PIN, toggle ? HIGH : LOW);
        
        if (toggle) {
            lcd_print_at(0, 0, (char*)"   WAKE UP!     ");
        } else {
            lcd_clear();
        }
        last_toggle = millis();
    }

    if (is_button_pressed(BTN4_PIN)) {
        digitalWrite(BUZZER_PIN, LOW);
        digitalWrite(RGB_RED_PIN, LOW);
        digitalWrite(RGB_GREEN_PIN, HIGH);
        delay(100);
        digitalWrite(RGB_GREEN_PIN, LOW);
        delay(100);
        digitalWrite(RGB_GREEN_PIN, HIGH);
        delay(100);
        digitalWrite(RGB_GREEN_PIN, LOW);
        delay(100);
        digitalWrite(RGB_GREEN_PIN, HIGH);
        delay(100);
        digitalWrite(RGB_GREEN_PIN, LOW);
        lcd_clear();
        return CLOCK_SCR;
    }

    return RINGING_SCR;
}

// 7. Current time and date setting screen
enum screen set_time_screen(struct context *ctx) {
    // 0 - hour, 1 - minute, 2 - day, 3 - month, 4 - year
    static int edit_mode = 0;
    static unsigned long last_update = 0;
    char buffer[17];

    // Init - get data from RTC on first entry
    if (last_update == 0) {
        struct dt current_dt = now();
        ctx->hour = current_dt.hours;
        ctx->minute = current_dt.minutes;
        ctx->day = current_dt.day;
        ctx->month = current_dt.month;
        ctx->year = current_dt.year;
        last_update = millis();
    }

    if (millis() - last_update > 200) {
        // Visual 
        if (edit_mode < 2) {
            lcd_print_at(0, 0, (char*)"Set RTC Time:   ");
            if (edit_mode == 0) sprintf(buffer, ">%02d< :  %02d      ", ctx->hour, ctx->minute);
            else                sprintf(buffer, " %02d  : >%02d<     ", ctx->hour, ctx->minute);
        } else {
            lcd_print_at(0, 0, (char*)"Set RTC Date:   ");
            if (edit_mode == 2)      sprintf(buffer, ">%02d</ %02d /%04d", ctx->day, ctx->month, ctx->year);
            else if (edit_mode == 3) sprintf(buffer, " %02d />%02d</%04d", ctx->day, ctx->month, ctx->year);
            else                     sprintf(buffer, " %02d / %02d />%04d<", ctx->day, ctx->month, ctx->year);
        }

        lcd_print_at(1, 0, buffer);
        last_update = millis();
    }

    // BTN1 - switch mode
    if (is_button_pressed(BTN1_PIN)) {
        edit_mode = (edit_mode + 1) % 5;
        last_update = millis(); // Reset timer  
    }

    // BTN2 - Add value
    if (is_button_pressed(BTN2_PIN)) {
        if (edit_mode == 0) ctx->hour = (ctx->hour + 1) % 24;
        else if (edit_mode == 1) ctx->minute = (ctx->minute + 1) % 60;
        else if (edit_mode == 2) ctx->day = (ctx->day % 31) + 1; // 31 day 
        else if (edit_mode == 3) ctx->month = (ctx->month % 12) + 1;
        else if (edit_mode == 4) ctx->year++;
        last_update = millis();
    }

    // BTN3 - Subtract value 
    if (is_button_pressed(BTN3_PIN)) {
        if (edit_mode == 0) ctx->hour = (ctx->hour == 0) ? 23 : ctx->hour - 1;
        else if (edit_mode == 1) ctx->minute = (ctx->minute == 0) ? 59 : ctx->minute - 1;
        else if (edit_mode == 2) ctx->day = (ctx->day == 1) ? 31 : ctx->day - 1;
        else if (edit_mode == 3) ctx->month = (ctx->month == 1) ? 12 : ctx->month - 1;
        else if (edit_mode == 4) ctx->year--;
        last_update = millis();
    }

    // BTN4 (Ok) - Save to RTC and exit
    if (is_button_pressed(BTN4_PIN)) {
        // Set RTC with new values 
        set_datetime(ctx->day, ctx->month, ctx->year, ctx->hour, ctx->minute, 0);

        lcd_clear();
        edit_mode = 0;   // Reset edit mode 
        last_update = 0; // Rest timer 
        return CLOCK_SCR;
    }

    return SET_TIME_SCR;
}
